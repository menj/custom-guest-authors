#: custom-guest-authors.php
msgid "Preview"
msgstr "Pratonton"

#: custom-guest-authors.php
msgid "Example output (3 authors)"
msgstr "Contoh output (3 pengarang)"

#: custom-guest-authors.php
msgid "Example output (2 authors)"
msgstr "Contoh output (2 pengarang)"

#: custom-guest-authors.php
msgid "Settings saved."
msgstr "Tetapan disimpan."

#: custom-guest-authors.php
msgid "Guest Author Name(s)"
msgstr "Nama Pengarang Tetamu"

#: custom-guest-authors.php
msgid "e.g. John Doe, Jane Smith"
msgstr "cth. Ali Hassan, Siti Aminah"

#: custom-guest-authors.php
msgid "Separate multiple authors with commas. Leave blank to use the post's WordPress author."
msgstr "Pisahkan berbilang pengarang dengan koma. Biarkan kosong untuk menggunakan pengarang WordPress catatan tersebut."
